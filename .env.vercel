# Vercel environment variables for cdtx-web-client.
# Import in Vercel: Project → Settings → Environment Variables → "Import .env" (paste or upload this file),
# apply to Production + Preview. These are baked in at BUILD time (Vite), so redeploy after changing them.
# Nothing here is secret — every VITE_* value ends up in the public JS bundle.

# Which product the storefront shows.
VITE_PRODUCT=zee5

# Leave EMPTY on Vercel: vercel.json rewrites /v1 and /image to the delivery API, so the browser's
# calls stay same-origin (no CORS needed). Only set an absolute URL if you remove those rewrites
# and the API allows this site's origin.
VITE_API_URL=

# Request-context defaults sent with every call.
VITE_DEFAULT_REGION=in
VITE_DEFAULT_LOCALE=en

# Optional — uncomment to use.
# VITE_DT=web
# VITE_DETAIL_PAGES={"movie":"detail-movie","series":"detail-series-detail-page","episode":"detail-episode-detail-page-roq"}
# VITE_PLAYER_SAMPLE=on
