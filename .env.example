# Base URL of the FastAPI backend. Leave empty to use the dev server's own
# proxy (see vite.config.ts) so browser calls stay same-origin; set an
# absolute URL for a build that talks to a different host.
VITE_API_URL=

# Delivery API request-context defaults. The seeded storefront only targets
# region "ph"; there is no geo-IP resolution yet, so this is a placeholder
# until real user-location resolution exists.
VITE_DEFAULT_REGION=ph
VITE_DEFAULT_LOCALE=en
