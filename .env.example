# The product to show: its key (or id). Everything else the client draws comes from the API's JSON.
VITE_PRODUCT=sunnxt

# Base URL of the delivery API. Leave empty to use the dev server's own proxy (see vite.config.ts) so
# browser calls stay same-origin; set an absolute URL for a build that talks to a different host.
VITE_API_URL=

# Where the dev server's proxy sends /v1 and /image (default: the live server).
# VITE_PROXY_TARGET=https://3-109-241-147.sslip.io

# Request-context defaults sent with every call.
VITE_DEFAULT_REGION=in
VITE_DEFAULT_LOCALE=en

# Optional: fix the device type the client asks as (default: web, mobileweb in a narrow window,
# androidtv in an Android TV browser).
# VITE_DT=web

# Which detail page opens for which kind of title (JSON). The API does not list detail pages, so the
# client is told. Kinds not listed have no detail page.
# VITE_DETAIL_PAGES={"movie":"detail-movie","series":"detail-series-detail-page","episode":"detail-episode-detail-page-roq"}

# The player's layout comes from GET /v1/player-config/{product}?dt=. While the product has none
# published (404), a development build shows the backend's sample layout (src/player/samples);
# set this to `on` to do the same in a production build. Off: the browser's own player.
# VITE_PLAYER_SAMPLE=on
